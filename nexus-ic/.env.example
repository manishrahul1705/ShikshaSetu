# Local prototype configuration. Copy to .env; never commit .env.
APP_MODE=demo
MONGODB_URI=mongodb://127.0.0.1:27017/awaaz_dastak_demo
CLIENT_ORIGIN=http://localhost:5173
# Optional comma-separated exact origins; blank falls back to CLIENT_ORIGIN.
# Render: https://shikshasetu.automconsultancy.in,https://shikshasetu-client-phi.vercel.app
CLIENT_ORIGINS=
# Render: 1 (nearest proxy only), including with a Vercel API rewrite.
TRUST_PROXY_HOPS=0
PORT=3000

# Generate a DIFFERENT value for each key using:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep VAULT_KEY and DOCS_KEY stable to read previously encrypted records.
SESSION_SECRET=
VAULT_KEY=
DOCS_KEY=

# Optional pending-case reminder scheduler. Requires an approved reminder rule.
REMINDERS_ENABLED=false
